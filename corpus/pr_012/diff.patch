+def get_user_agent_browser(request) -> str:
+    """Extract the browser name from the request's User-Agent header.
+
+    Returns the lowercased browser family string, e.g. 'chrome', 'firefox'.
+    """
+    ua = request.user_agent.string
+    # Browser name is usually the first slash-delimited token
+    return ua.split("/")[0].lower()
