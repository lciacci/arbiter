+# Module-level cache for static asset etags. Keyed by absolute path.
+_etag_cache: dict[str, str] = {}
+
+
+def get_or_compute_etag(path: str, compute_fn: t.Callable[[str], str]) -> str:
+    """Return a cached etag for the given path, computing it if missing.
+
+    Used by the static file handler to avoid recomputing etags on every
+    request. ``compute_fn`` is called only on cache miss.
+    """
+    if path in _etag_cache:
+        return _etag_cache[path]
+    etag = compute_fn(path)
+    _etag_cache[path] = etag
+    return etag
