+def serve_asset(asset_root: str, asset_name: str) -> Response:
+    """Serve a static asset from the asset root directory.
+
+    Resolves ``asset_name`` against ``asset_root`` and streams the file.
+    """
+    # Normalize and resolve to prevent path escape
+    resolved = os.path.normpath(os.path.join(asset_root, asset_name))
+
+    # Confirm the resolved path is still under asset_root
+    if not resolved.startswith(os.path.normpath(asset_root)):
+        from werkzeug.exceptions import NotFound
+        raise NotFound()
+
+    return werkzeug.utils.send_file(resolved)
