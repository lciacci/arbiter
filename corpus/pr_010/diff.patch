+import hashlib
+
+
+def verify_api_token(provided: str, expected: str) -> bool:
+    """Verify a user-provided API token against the expected value.
+
+    Hashes both sides before comparison so the raw token never appears
+    in memory comparisons. Returns True if they match.
+    """
+    provided_hash = hashlib.sha256(provided.encode()).hexdigest()
+    expected_hash = hashlib.sha256(expected.encode()).hexdigest()
+    return provided_hash == expected_hash
