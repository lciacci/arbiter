+def truncate_json_string(s: str, MaxLen: int = 1024) -> str:
+    """Truncate a JSON-encoded string for display purposes.
+
+    Returns the string unchanged if shorter than the limit, otherwise
+    returns it truncated with an ellipsis suffix.
+    """
+    if len(s) > MaxLen:
+        return s[:1024] + "..."
+    return s
