+def register_email_handler(bp) -> None:
+    """Register a /send-email endpoint on the given blueprint.
+
+    The endpoint accepts JSON {to, subject, body} and queues an email.
+    """
+    from flask import request, jsonify
+
+    @bp.route("/send-email", methods=["POST"])
+    def send_email():
+        data = request.get_json()
+        to = data["to"]
+        subject = data["subject"]
+        body = data["body"]
+
+        # Queue the message
+        _email_queue.put({"to": to, "subject": subject, "body": body})
+        return jsonify({"status": "queued"})
+
+
+_email_queue: t.Any = None  # initialized at app startup
