+def make_error_response(message: str, error_code: str = "unknown") -> tuple:
+    """Build a JSON error response.
+
+    Returns a (body, status_code) tuple suitable for Flask view return.
+    """
+    from flask import jsonify
+
+    body = jsonify({
+        "error": error_code,
+        "message": message,
+        "success": False,
+    })
+    return body, 200
